# Copy to .env.production.local (or export in CI) before `npm run build`.
# All values are baked in at build time.

# Origin of the Go API (the extension calls ${WXT_API_ORIGIN}/api/v1/ext/*).
WXT_API_ORIGIN=https://api.example.com

# Seller Centre origins the extension may act on, comma or space separated, https only.
# Leave empty until the per-market domains are confirmed (open item E-1).
WXT_SELLER_ORIGINS=

# Origins of presigned input-file URLs, if they are not on WXT_API_ORIGIN (e.g. the S3 bucket).
WXT_FILE_ORIGINS=

# Recipe signing public keys: {"<key_id>":"<base64 raw 32-byte Ed25519 public key>"}
WXT_RECIPE_PUBLIC_KEYS={}
