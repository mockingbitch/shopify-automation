# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
HTTP_ADDR=:8080
# Dashboard origin: email links and the Origin check use it. In development
# the Nuxt dev server (port 3100) proxies /api to the Go server (port 8080).
PUBLIC_BASE_URL=http://localhost:3100

DATABASE_URL=postgres://app_rw:rw_dev_pw@localhost:5433/shopee_automation?sslmode=disable
DATABASE_SYSTEM_URL=postgres://app_system:system_dev_pw@localhost:5433/shopee_automation?sslmode=disable
DATABASE_MIGRATE_URL=postgres://app_owner:owner_dev_pw@localhost:5433/shopee_automation?sslmode=disable

REDIS_URL=redis://:redis_dev_pw@localhost:6379/0

SMTP_ADDR=localhost:1025
SMTP_FROM=no-reply@shopee-automation.local

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug

# Object storage (S3 API). Development uses SeaweedFS from deploy/docker-compose.yml.
S3_ENDPOINT=localhost:8333
S3_ACCESS_KEY=dev_s3_access
S3_SECRET_KEY=dev_s3_secret_not_for_production
S3_BUCKET=shopee-automation
S3_REGION=us-east-1
S3_USE_SSL=false

# Envelope encryption for Shopee tokens and partner keys. Generate with
# `go run ./cmd/admin gen-key`. Format: id:base64key[,id:base64key].
ENCRYPTION_KEYS=dev1:REPLACE_WITH_OUTPUT_OF_go_run_./cmd/admin_gen-key
ENCRYPTION_ACTIVE_KEY=dev1

# Secure cookies require HTTPS. Keep false only for local http.
COOKIE_SECURE=false

# Integration tests (make test-integration)
TEST_DATABASE_OWNER_URL=postgres://app_owner:owner_dev_pw@localhost:5433/postgres?sslmode=disable
TEST_DATABASE_RW_URL=postgres://app_rw:rw_dev_pw@localhost:5433/postgres?sslmode=disable
TEST_DATABASE_SYSTEM_URL=postgres://app_system:system_dev_pw@localhost:5433/postgres?sslmode=disable
TEST_S3_ENDPOINT=localhost:8333
TEST_S3_ACCESS_KEY=dev_s3_access
TEST_S3_SECRET_KEY=dev_s3_secret_not_for_production
TEST_REDIS_URL=redis://:redis_dev_pw@localhost:6379/1

# Browser extension. Generate with: go run ./cmd/admin gen-recipe-key
# (the public key goes into the extension build as WXT_RECIPE_PUBLIC_KEYS).
RECIPE_SIGNING_KEY=
RECIPE_SIGNING_KEY_ID=k1
# chrome-extension://<id> of the installed extension, comma separated.
EXTENSION_ORIGINS=
