# Example settings for deploy/production/docker-compose.yml.
# Copy to production.env (git-ignored) and replace every placeholder.
# Secrets do NOT go here: they go in deploy/production/secrets/<name>
# (see secrets.example/ and docs/deployment.md).

# Image built by .github/workflows/release.yml.
IMAGE=ghcr.io/OWNER/REPO
IMAGE_TAG=v0.0.0

# Unpacked web release artifact (contains public/ and csp.conf).
WEB_DIST_DIR=/srv/shopee-automation/web/current
# Directory holding fullchain.pem and privkey.pem for the public host.
TLS_DIR=/etc/shopee-automation/tls
HTTP_PORT=80
HTTPS_PORT=443

# Must be https in production; same host as nginx server_name.
PUBLIC_BASE_URL=https://app.example.com
LOG_LEVEL=info

# Id of the active key inside the encryption_keys secret.
ENCRYPTION_ACTIVE_KEY=prod1

# Managed S3-compatible storage (host[:port], TLS always on in production).
S3_ENDPOINT=s3.example-region.example.com
S3_BUCKET=shopee-automation-prod
S3_REGION=example-region-1

# SMTP relay host:port and sender.
SMTP_ADDR=smtp-relay.internal.example:25
SMTP_FROM=no-reply@example.com

# OpenTelemetry collector (OTLP/HTTP). Empty disables tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Browser extension.
RECIPE_SIGNING_KEY_ID=k1
EXTENSION_ORIGINS=chrome-extension://REPLACE_WITH_EXTENSION_ID

# Optional ClamAV (start with --profile clamav). Empty disables scanning.
CLAMAV_ADDR=

WORKER_CONCURRENCY=10
WORKFLOW_ORG_CONCURRENCY=10
# Deleted organizations are purged after this long (minimum 24h).
ORG_RETENTION=720h
# Breached-password check; empty disables it.
PWNED_PASSWORDS_URL=https://api.pwnedpasswords.com/range/
