{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shopee-automation.local/templates/product_defaults.json",
  "title": "Mặc định cho sản phẩm",
  "description": "Giá trị mặc định cho sản phẩm tạo từ file nhập.",
  "type": "object",
  "additionalProperties": false,
  "x-applies-to": "products",
  "properties": {
    "condition": {
      "type": "string",
      "enum": [
        "NEW",
        "USED"
      ],
      "title": "Tình trạng"
    },
    "item_status": {
      "type": "string",
      "enum": [
        "NORMAL",
        "UNLIST"
      ],
      "title": "Trạng thái sau khi tạo",
      "description": "UNLIST giữ sản phẩm mới ở trạng thái ẩn cho đến khi được kiểm tra."
    },
    "weight_kg": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "title": "Cân nặng (kg)",
      "description": "Giới hạn cân nặng của từng đơn vị vận chuyển được kiểm tra khi áp dụng."
    },
    "package_cm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length",
        "width",
        "height"
      ],
      "title": "Kích thước đóng gói (cm)",
      "properties": {
        "length": {
          "type": "integer",
          "title": "Dài",
          "minimum": 1,
          "maximum": 1000
        },
        "width": {
          "type": "integer",
          "title": "Rộng",
          "minimum": 1,
          "maximum": 1000
        },
        "height": {
          "type": "integer",
          "title": "Cao",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "pre_order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_pre_order"
      ],
      "title": "Hàng đặt trước",
      "properties": {
        "is_pre_order": {
          "type": "boolean",
          "title": "Là hàng đặt trước"
        },
        "days_to_ship": {
          "type": "integer",
          "title": "Số ngày chuẩn bị hàng",
          "minimum": 1,
          "maximum": 90,
          "description": "Khoảng cho phép do Shopee quy định theo ngành hàng; được kiểm tra khi áp dụng."
        }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand_id",
        "original_brand_name"
      ],
      "title": "Thương hiệu",
      "properties": {
        "brand_id": {
          "type": "integer",
          "title": "ID thương hiệu",
          "minimum": 0,
          "description": "Nhập 0 kèm tên \"No Brand\" nếu sản phẩm không có thương hiệu."
        },
        "original_brand_name": {
          "type": "string",
          "title": "Tên thương hiệu",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "stock": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000,
      "title": "Tồn kho mặc định"
    }
  }
}
