{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shopee-automation.local/templates/return_address.json",
  "title": "Địa chỉ trả hàng",
  "description": "Địa chỉ lấy hàng/trả hàng. Địa chỉ đã có được sửa qua API của Shopee; Shopee không có API để tạo địa chỉ mới (tiện ích trình duyệt hoặc làm thủ công). Chỉ thay đổi khi bạn đánh dấu chọn ở bước duyệt.",
  "type": "object",
  "additionalProperties": false,
  "x-applies-to": "shop",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "title": "Tên người nhận"
    },
    "phone": {
      "type": "string",
      "pattern": "^\\+[1-9][0-9]{6,14}$",
      "description": "Định dạng quốc tế, ví dụ +84901234567.",
      "title": "Số điện thoại người nhận"
    },
    "state": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "title": "Tỉnh / thành phố"
    },
    "city": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "title": "Thành phố / thị xã"
    },
    "district": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "title": "Quận / huyện"
    },
    "town": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "title": "Phường / xã"
    },
    "address": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "title": "Địa chỉ cụ thể"
    },
    "zipcode": {
      "type": "string",
      "pattern": "^[A-Za-z0-9 -]{3,12}$",
      "title": "Mã bưu chính"
    },
    "use_as": {
      "type": "array",
      "uniqueItems": true,
      "title": "Dùng làm",
      "items": {
        "type": "string",
        "enum": [
          "DEFAULT_ADDRESS",
          "PICKUP_ADDRESS",
          "RETURN_ADDRESS"
        ]
      },
      "x-capability": "shop.address.config",
      "description": "Loại địa chỉ trên Shopee (mặc định, lấy hàng, trả hàng)."
    }
  },
  "x-capability": "shop.address.update",
  "x-sensitive": true
}
