{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shopee-automation.local/templates/warehouse.json",
  "title": "Kho hàng",
  "description": "Cài đặt kho hàng. Shopee không có API để thay đổi kho hàng; đây là hướng dẫn cho tiện ích trình duyệt hoặc việc làm thủ công.",
  "type": "object",
  "additionalProperties": false,
  "x-applies-to": "shop",
  "properties": {
    "instructions": {
      "type": "string",
      "maxLength": 4000,
      "title": "Hướng dẫn",
      "x-capability": "shop.warehouse.update",
      "x-multiline": true
    }
  }
}
