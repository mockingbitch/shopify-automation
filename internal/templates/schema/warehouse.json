{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shopee-automation.local/templates/warehouse.json",
  "title": "Warehouse",
  "description": "Warehouse settings. Shopee has no Open API to change warehouses; these are instructions for the browser extension or a manual task.",
  "type": "object",
  "additionalProperties": false,
  "x-applies-to": "shop",
  "properties": {
    "instructions": {
      "type": "string",
      "maxLength": 4000,
      "title": "Instructions",
      "x-capability": "shop.warehouse.update",
      "x-multiline": true
    }
  }
}
