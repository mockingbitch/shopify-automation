{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shopee-automation.local/templates/default_attributes.json",
  "title": "Thuộc tính mặc định",
  "description": "Giá trị thuộc tính gán cho sản phẩm. Giá trị hợp lệ tùy theo từng ngành hàng trên Shopee.",
  "type": "object",
  "additionalProperties": false,
  "x-applies-to": "products",
  "properties": {
    "attributes": {
      "type": "array",
      "maxItems": 500,
      "title": "Thuộc tính",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attribute_id",
          "value_id"
        ],
        "properties": {
          "category_id": {
            "type": "integer",
            "minimum": 1,
            "title": "Chỉ cho ngành hàng",
            "description": "Để trống: áp dụng cho mọi ngành hàng có thuộc tính này."
          },
          "attribute_id": {
            "type": "integer",
            "minimum": 1,
            "title": "ID thuộc tính"
          },
          "value_id": {
            "type": "integer",
            "minimum": 0,
            "title": "ID giá trị",
            "description": "Nhập 0 nếu là giá trị tự nhập; khi đó bắt buộc nhập tên giá trị."
          },
          "original_value_name": {
            "type": "string",
            "maxLength": 200,
            "title": "Tên giá trị"
          },
          "value_unit": {
            "type": "string",
            "maxLength": 20,
            "title": "Đơn vị"
          }
        },
        "if": {
          "properties": {
            "value_id": {
              "const": 0
            }
          }
        },
        "then": {
          "required": [
            "original_value_name"
          ]
        }
      }
    }
  }
}
