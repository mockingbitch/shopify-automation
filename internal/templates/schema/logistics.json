{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shopee-automation.local/templates/logistics.json",
  "title": "Vận chuyển",
  "description": "Các đơn vị vận chuyển cần bật hoặc tắt. ID đơn vị vận chuyển khác nhau theo từng thị trường.",
  "type": "object",
  "additionalProperties": false,
  "x-applies-to": "shop",
  "properties": {
    "channels": {
      "type": "array",
      "maxItems": 100,
      "title": "Đơn vị vận chuyển",
      "x-capability": "shop.logistics.update",
      "x-sensitive": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "logistics_channel_id",
          "enabled"
        ],
        "properties": {
          "logistics_channel_id": {
            "type": "integer",
            "minimum": 1,
            "title": "ID đơn vị vận chuyển"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "title": "Tên hiển thị",
            "description": "Chỉ để hiển thị."
          },
          "enabled": {
            "type": "boolean",
            "title": "Bật"
          },
          "cod_enabled": {
            "type": "boolean",
            "title": "Thanh toán khi nhận hàng (COD)",
            "description": "Chỉ dành cho đơn vị vận chuyển hỗ trợ COD."
          }
        }
      }
    }
  }
}
