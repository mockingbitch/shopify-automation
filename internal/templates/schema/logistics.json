{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shopee-automation.local/templates/logistics.json",
  "title": "Logistics",
  "description": "Shipping channels to enable or disable. Channel IDs are market-specific (logistics/get_channel_list).",
  "type": "object",
  "additionalProperties": false,
  "x-applies-to": "shop",
  "properties": {
    "channels": {
      "type": "array",
      "maxItems": 100,
      "title": "Channels",
      "x-capability": "shop.logistics.update",
      "x-sensitive": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "logistics_channel_id",
          "enabled"
        ],
        "properties": {
          "logistics_channel_id": {
            "type": "integer",
            "minimum": 1,
            "title": "Channel ID"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "title": "Label",
            "description": "For display only."
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "cod_enabled": {
            "type": "boolean",
            "title": "Cash on delivery",
            "description": "Only for channels that support COD."
          }
        }
      }
    }
  }
}
