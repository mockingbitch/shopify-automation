{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shopee-automation.local/templates/category_mappings.json",
  "title": "Ánh xạ ngành hàng",
  "description": "Gán nhãn ngành hàng trong file nhập với ID ngành hàng cấp cuối của Shopee.",
  "type": "object",
  "additionalProperties": false,
  "x-applies-to": "products",
  "properties": {
    "mappings": {
      "type": "array",
      "maxItems": 2000,
      "title": "Danh sách ánh xạ",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "shopee_category_id"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "title": "Nhãn ngành hàng trong file của bạn"
          },
          "shopee_category_id": {
            "type": "integer",
            "minimum": 1,
            "title": "ID ngành hàng Shopee"
          }
        }
      }
    }
  }
}
