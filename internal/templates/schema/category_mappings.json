{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shopee-automation.local/templates/category_mappings.json",
  "title": "Category mappings",
  "description": "Maps category labels used in import files to Shopee leaf category IDs (product/get_category).",
  "type": "object",
  "additionalProperties": false,
  "x-applies-to": "products",
  "properties": {
    "mappings": {
      "type": "array",
      "maxItems": 2000,
      "title": "Mappings",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "shopee_category_id"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "title": "Category label in your files"
          },
          "shopee_category_id": {
            "type": "integer",
            "minimum": 1,
            "title": "Shopee category ID"
          }
        }
      }
    }
  }
}
