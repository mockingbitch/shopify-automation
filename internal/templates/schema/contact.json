{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shopee-automation.local/templates/contact.json",
  "title": "Contact",
  "description": "Contact details used as defaults for addresses and descriptions. Shopee has no Open API for shop contact details, so this section is not applied on its own.",
  "type": "object",
  "additionalProperties": false,
  "x-applies-to": "defaults",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "title": "Contact name"
    },
    "phone": {
      "type": "string",
      "pattern": "^\\+[1-9][0-9]{6,14}$",
      "description": "E.164, e.g. +84901234567.",
      "title": "Phone"
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254,
      "title": "Email"
    }
  }
}
