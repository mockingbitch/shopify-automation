{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shopee-automation.local/templates/sku_rules.json",
  "title": "SKU rules",
  "description": "How item_sku is generated when an import row has none. A unique item_sku is required for duplicate protection.",
  "type": "object",
  "additionalProperties": false,
  "x-applies-to": "products",
  "properties": {
    "prefix": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{0,20}$",
      "title": "Prefix"
    },
    "separator": {
      "type": "string",
      "enum": [
        "",
        "-",
        "_"
      ],
      "title": "Separator"
    },
    "sequence_digits": {
      "type": "integer",
      "minimum": 3,
      "maximum": 8,
      "title": "Sequence digits"
    },
    "uppercase": {
      "type": "boolean",
      "title": "Uppercase"
    },
    "generate_when_missing": {
      "type": "boolean",
      "title": "Generate when missing"
    }
  }
}
