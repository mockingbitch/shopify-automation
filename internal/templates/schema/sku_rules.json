{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shopee-automation.local/templates/sku_rules.json",
  "title": "Quy tắc SKU",
  "description": "Cách tạo SKU khi dòng nhập không có SKU. Mỗi sản phẩm cần SKU riêng để tránh đăng trùng.",
  "type": "object",
  "additionalProperties": false,
  "x-applies-to": "products",
  "properties": {
    "prefix": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{0,20}$",
      "title": "Tiền tố"
    },
    "separator": {
      "type": "string",
      "enum": [
        "",
        "-",
        "_"
      ],
      "title": "Ký tự phân cách"
    },
    "sequence_digits": {
      "type": "integer",
      "minimum": 3,
      "maximum": 8,
      "title": "Số chữ số của số thứ tự"
    },
    "uppercase": {
      "type": "boolean",
      "title": "Viết hoa"
    },
    "generate_when_missing": {
      "type": "boolean",
      "title": "Tự tạo khi thiếu"
    }
  }
}
